# ---------------------------------------------------
# Backend (place in backend/.env)
# ---------------------------------------------------

# MySQL connection string
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/food_ordering

# Secret key used to sign JWTs
JWT_SECRET_KEY=
# Secret key used to sign password reset / email verification tokens
SECRET_KEY=

# Mail server config (for password reset emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe API keys (test mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ---------------------------------------------------
# Frontend (place in frontend/.env.local)
# ---------------------------------------------------

# Base URL of the running backend
VITE_API_URL=http://localhost:5000

# Stripe publishable key (safe to expose on frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
